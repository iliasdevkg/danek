# ---------------------------------------------------------------------------
# Supabase — панель проекта → Settings → API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Публикуемый ключ (новые проекты: sb_publishable_…). Попадает в браузер — это норма,
# доступ ограничивают политики RLS, а не секретность ключа.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Служебный ключ: обходит RLS полностью. Только серверный код, никогда NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Сайт
# ---------------------------------------------------------------------------
# Боевой адрес без слэша на конце. Нужен для canonical, hreflang и sitemap.
# На превью Vercel подставляется автоматически — заполняйте только для продакшена.
NEXT_PUBLIC_SITE_URL=
